<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14" styleClass="content-area" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Button fx:id="aturKomponenBtn" onAction="#handleAturKomponen" styleClass="btn-primary" text="Tambah Komponen Nilai" />
        <Button fx:id="importBtn" onAction="#handleImport" styleClass="btn-secondary" text="Import Excel / CSV" />
        <Button fx:id="templateBtn" onAction="#handleTemplate" style="-fx-background-color: #E3F2FD; -fx-text-fill: #1565C0; -fx-font-size: 13px; -fx-padding: 8 16 8 16; -fx-background-radius: 6; -fx-cursor: hand; -fx-border-color: #90CAF9; -fx-border-radius: 6;" styleClass="btn-secondary" text="Unduh Template CSV" />
        <Button fx:id="pasteBtn" onAction="#handlePaste" style="-fx-background-color: #E8F5E9; -fx-text-fill: #2E7D32; -fx-font-size: 13px; -fx-padding: 8 16 8 16; -fx-background-radius: 6; -fx-cursor: hand; -fx-border-color: #A5D6A7; -fx-border-radius: 6;" styleClass="btn-secondary" text="Tempel (Paste)" />
        <Button fx:id="simpanBtn" onAction="#handleSimpan" styleClass="btn-primary" text="Simpan Perubahan" />
        <Button fx:id="exportBtn" onAction="#handleExport" styleClass="btn-secondary" text="Export Excel" />
    </HBox>

    <VBox spacing="12" styleClass="card" VBox.vgrow="ALWAYS">
        <Label fx:id="tableTitle" styleClass="section-title" />
        <TableView fx:id="table" editable="true" VBox.vgrow="ALWAYS">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            <!-- Columns are dynamically generated in the controller based on KomponenNilai list -->
        </TableView>
    </VBox>

</VBox>
